# Which provider serves the open-weight model: "groq" (hosted) or "ollama" (local).
MODEL_PROVIDER=groq

# Groq — free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama — for a fully offline run: `ollama pull qwen2.5-coder:7b`
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b
